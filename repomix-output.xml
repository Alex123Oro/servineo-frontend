              <FixerRegisterForm
                defaultValues={defaultValues}
                onSubmit={(data) => {
                  const finalUser: IUser = {
                    _id: user?._id || '',
                    name: data.name || user?.name || '',
                    email: data.email || user?.email || '',
                    telefono: data.phone,
                    url_photo: user?.url_photo || 'https://picsum.photos/80',
