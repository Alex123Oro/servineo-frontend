          ${
            isOpen
              ? "border-blue-500 shadow-[0_0_30px_rgba(59,130,246,0.3)] scale-105 bg-white"
              : "border-blue-200 hover:border-blue-400 hover:shadow-[0_0_20px_rgba(59,130,246,0.2)] hover:scale-102"
          }
