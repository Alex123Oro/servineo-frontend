}

.custom-offer-marker:hover {
  filter: drop-shadow(0 8px 12px rgba(59, 130, 246, 0.15));
  transform: translateY(-4px);
}

/* Animation Keyframes */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fadeInUp {
  animation: fadeInUp 0.5s ease-out forwards;
}

.custom-user-marker {
