            </div>
            <div className="flex gap-2">
              {!editingDescription ? (
                <button
                  onClick={() => setEditingDescription(true)}
                  className="px-4 py-2 bg-gray-100 hover:bg-gray-200 text-gray-700 rounded-full text-sm font-medium transition-colors flex items-center gap-1"
