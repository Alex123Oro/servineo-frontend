export default function BecomeFixerPage() {
  const router = useRouter();
  const user = useSelector((state: RootState) => state.user.user);

  const [requester, setRequester] = useState<IUser | null>(null);

  useEffect(() => {
    if (user?.role === 'fixer') {
      router.push('/fixer/dashboard');
    }
  }, [user, router]);

  const defaultValues = {
    name: user?.name || '',
    email: user?.email || '',
    phone: user?.telefono || '',
