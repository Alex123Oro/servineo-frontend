              href={fixer.available ? `https://wa.me/591${fixer.id}` : "#"}
              target="_blank"
              rel="noreferrer"
              style={{
                flex: 1,
                padding: "8px 0",
                background: fixer.available ? palette.whatsappBg : "#ccc",
                color: palette.buttonText,
                borderRadius: "12px",
                fontWeight: 600,
                fontSize: "13px",
                textAlign: "center",
                textDecoration: "none",
                pointerEvents: fixer.available ? "auto" : "none",
